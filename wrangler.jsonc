{
  "name": "moneynews",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Keep variables and secrets added in the Cloudflare dashboard when a deploy runs. Without this a deploy
  // from this file replaces dashboard variables with the ones below, which can silently remove GEMINI_API_KEY.
  "keep_vars": true,

  // Static UI lives in ./public. The Worker only runs for /api/* (and cron).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // On every `wrangler dev` / `wrangler deploy` (and every Cloudflare build): regenerate src/schema.ts from
  // schema.sql and rebuild the Tailwind stylesheet. The Worker creates its own tables on first use.
  "build": { "command": "npm run build" },

  // WORKERS FREE (default): five triggers, one minute apart, each running one slice of the pipeline,
  // so every invocation gets its own CPU / subrequest / D1-query budget.
  //   :00 collect (poll sources)        :01 research + edit          :02 fact-check + translate (KA)
  //   :03 Georgian grammar + publish    :04 collect (next sources)
  // An article drafted at :01 is published at :03. These five expressions must match STAGED_CRONS
  // in src/pipeline/run.ts. Free accounts allow 5 cron triggers in total, so turn off the crons on
  // the old ioane-agent and ioane-agent-2 Workers first.
  //
  // WORKERS PAID: use one trigger instead and set PIPELINE_MODE to "single" and FEEDS_PER_RUN to "170"
  // so every source is searched every 5 minutes:
  //   "triggers": { "crons": ["*/5 * * * *"] }
  "triggers": {
    "crons": ["*/5 * * * *", "1-59/5 * * * *", "2-59/5 * * * *", "3-59/5 * * * *", "4-59/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ioane-news",
      // Create it once:  npx wrangler d1 create ioane-news   then paste the id here.
      "database_id": "944aa348-911c-4db4-9182-878f9c801456"
    }
  ],

  "vars": {
    // Same variable name agent 2 uses. Google retires old models for new accounts (gemini-2.5-flash
    // already answers "no longer available to new users"), so check the current names at
    // https://ai.google.dev/gemini-api/docs/models and change this line if the pipeline reports a 404.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Flash-Lite is Google's cheapest tier: most requests per day and per minute, but the weakest at
    // Georgian. Optional: a different model for the two Georgian stages (translate + Georgian grammar
    // check). If the Georgian reads badly, uncomment this to use the larger model for those two only:
    // "GEMINI_MODEL_KA": "gemini-3.8-flash",

    "PIPELINE_MODE": "staged",    // "staged" (Free) or "single" (Paid)
    "FEEDS_PER_RUN": "25",        // sources per collect: 25 -> 7 groups of about 23, all 159 feeds covered about every 17 minutes
    "MAX_ARTICLES_PER_RUN": "3",  // new drafts per run, and the batch size of every later stage
    "PUBLISH_THRESHOLD": "60",    // minimum trust score (0-100) to publish
    "SOURCE_PHOTOS": "all"        // story pictures: "all" = the one a source supplied (credited, hotlinked), "primary" = only from official sources, "off" = public-domain stock photos only
  }

  // Secrets (set with `wrangler secret put`, never put them in this file):
  //   GEMINI_API_KEY   - same key agent 2 uses
  //   ADMIN_KEY        - enables POST /api/run (manual pipeline trigger)
}
